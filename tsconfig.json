{
  "compilerOptions": {
    "target": "ES2022", // Specifies the JavaScript version to target when transpiling code.
    "lib": ["ES2022", "DOM"], // Specifies the libraries available for the code.
    // NodeNext rather than bundler resolution, even though Vite does the bundling: vite-plugin-dts copies
    // relative import specifiers into dist/**/*.d.ts verbatim, and consumers using node16/nodenext resolution
    // can only follow them if they carry an explicit extension (`./Button.js`, `./button/index.js`).
    // NodeNext makes `tsc` reject extensionless relative imports in the shipped source.
    "module": "NodeNext", // Defines the module system to use for code generation.
    "moduleResolution": "NodeNext", // Requires explicit .js extensions on relative imports (see above).
    "skipLibCheck": true, // Skips type checking of declaration files.

    "allowImportingTsExtensions": true, // Allows importing TypeScript files with extensions.
    "resolveJsonModule": true, // Enables importing JSON modules.
    "isolatedModules": true, // Ensures each file is treated as a separate module.
    "noEmit": true, // Prevents TypeScript from emitting output files.
    "jsx": "react-jsx", // Configures JSX support for React.

    /* Linting */
    "strict": true, // Enables strict type checking.
    "noUnusedLocals": true, // Flags unused local variables.
    "noUnusedParameters": true, // Flags unused function parameters.
    "noFallthroughCasesInSwitch": true, // Requires handling all cases in a switch statement.
    "declaration": true, // Generates declaration files for TypeScript.
    "types": ["vite/client"] // Provides ImportMeta.env typings from Vite; test matcher types come from vitest.shims.d.ts.
  },
  "include": ["components", "index.ts"], // Specifies the directory to include when searching for TypeScript files.
  "exclude": [
    "components/**/*.stories.tsx",
    "components/**/*.test.tsx",
    "components/**/*.figma.ts"
  ]
}
